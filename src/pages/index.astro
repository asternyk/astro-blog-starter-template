<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="North Documentary" />
    <title>North Documentary</title>
  </head>

  <body>
    <main>
      <div class="status">Under construction</div>

      <h1>North Documentary</h1>

      <a href="mailto:contact@northdocfilm.com">
        contact@northdocfilm.com
      </a>
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    min-height: 100%;
  }

  body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;

    background: #0a0a0a;
    color: #f5f5f5;

    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  main {
    width: 100%;
    padding: 40px 24px;
    text-align: center;
  }

  .status {
    margin-bottom: 60px;

    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.25em;

    opacity: 0.5;
  }

  h1 {
    margin-bottom: 32px;

    font-size: clamp(2.5rem, 8vw, 7rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  a {
    color: inherit;
    font-size: 14px;
    text-decoration: none;

    border-bottom: 1px solid #555;
    padding-bottom: 4px;

    transition: border-color 0.2s ease;
  }

  a:hover {
    border-color: #fff;
  }
</style>
